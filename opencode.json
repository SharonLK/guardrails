  "mcp": {},

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",

          "pwd": "allow",
          "Get-Location": "allow",

          "dir": "allow",
          "dir *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "Get-ChildItem": "allow",
